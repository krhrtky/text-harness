#!/bin/sh

set -u

readonly EXPECTED_NODE_VERSION="v24.19.0"
readonly EXPECTED_PNPM_VERSION="11.22.0"

usage() {
  printf '%s\n' \
    'usage: scripts/text-harness-setup --check' \
    '       scripts/text-harness-setup --install' \
    '       scripts/text-harness-setup --upgrade --from <git-ref>' >&2
  exit 2
}

fail() {
  code=$1
  shift
  printf 'SETUP ERROR code=%s %s\n' "$code" "$*" >&2
  exit "$code"
}

parse_arguments() {
  mode=
  from_ref=
  case "$#:$1" in
    1:--check) mode=check ;;
    1:--install) mode=install ;;
    3:--upgrade)
      [ "$2" = "--from" ] && [ -n "$3" ] || usage
      mode=upgrade
      from_ref=$3
      ;;
    *) usage ;;
  esac
}

find_repository_root() {
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || fail 4 'repository root unavailable'
  repository_root=$(CDPATH= cd -- "$script_dir/.." 2>/dev/null && pwd) || fail 4 'repository root unavailable'
  [ "$repository_root" != "/" ] || fail 4 'invalid repository root'
  cd -- "$repository_root" || fail 4 'repository root unavailable'
}

check_toolchain() {
  command -v node >/dev/null 2>&1 || fail 3 'node is required'
  command -v pnpm >/dev/null 2>&1 || fail 3 'pnpm is required'
  node_version=$(node --version 2>/dev/null) || fail 3 'node version unavailable'
  pnpm_version=$(pnpm --version 2>/dev/null) || fail 3 'pnpm version unavailable'
  [ "$node_version" = "$EXPECTED_NODE_VERSION" ] || fail 3 "expected node $EXPECTED_NODE_VERSION, found $node_version"
  [ "$pnpm_version" = "$EXPECTED_PNPM_VERSION" ] || fail 3 "expected pnpm $EXPECTED_PNPM_VERSION, found $pnpm_version"
}

check_repository() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail 4 'git work tree required'
  git rev-parse --verify HEAD >/dev/null 2>&1 || fail 4 'baseline commit required; unborn HEAD is not installable'

  protected_status=$(git status --porcelain -- \
    AGENTS.md \
    scripts/text-harness-setup \
    tests/ops \
    tests/fixtures/upgrade/v0.0.0-baseline \
    package.json \
    pnpm-lock.yaml \
    .node-version) || fail 4 'protected path status unavailable'
  [ -z "$protected_status" ] || fail 4 'protected paths are dirty'
}

check_upgrade_baseline() {
  git cat-file -e "$from_ref^{commit}" >/dev/null 2>&1 || fail 4 "previous baseline does not exist: $from_ref"
  for required_path in package.json pnpm-lock.yaml .node-version; do
    git cat-file -e "$from_ref:$required_path" >/dev/null 2>&1 || fail 4 "previous baseline is incomplete: $required_path"
  done
}

config_path() {
  if [ -n "${TEXT_HARNESS_CONFIG_HOME:-}" ]; then
    printf '%s/config.json\n' "$TEXT_HARNESS_CONFIG_HOME"
  else
    [ -n "${HOME:-}" ] || fail 2 'HOME or TEXT_HARNESS_CONFIG_HOME is required'
    printf '%s/.config/text-harness/config.json\n' "$HOME"
  fi
}

sha256_file() {
  target=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$target" | awk '{print $1}'
    return
  fi
  command -v shasum >/dev/null 2>&1 || return 1
  shasum -a 256 "$target" | awk '{print $1}'
}

hash_file() {
  target=$1
  if [ ! -e "$target" ]; then
    printf '<absent>\n'
    return
  fi
  [ -f "$target" ] || fail 2 "config is not a regular file: $target"
  sha256_file "$target" || fail 2 'SHA-256 calculation failed'
}

file_mode() {
  target=$1
  if stat -f '%Lp' "$target" >/dev/null 2>&1; then
    stat -f '%Lp' "$target"
    return
  fi
  stat -c '%a' "$target" 2>/dev/null
}

rollback_modules() {
  if [ -n "${rollback_dir:-}" ] && [ -d "$rollback_dir" ]; then
    if [ -e node_modules ]; then
      rm -rf -- node_modules
    fi
    mv -- "$rollback_dir" node_modules
  elif [ "${had_modules:-0}" = 0 ] && [ -e node_modules ]; then
    rm -rf -- node_modules
  fi
}

discard_rollback() {
  if [ -n "${rollback_dir:-}" ] && [ -d "$rollback_dir" ]; then
    rm -rf -- "$rollback_dir"
  fi
}

prepare_config_guard() {
  config_backup_dir=$(mktemp -d "${TMPDIR:-/tmp}/text-harness-config.XXXXXX") || fail 5 'cannot create config backup directory'
  config_backup_file="$config_backup_dir/config.json"
  config_existed=0
  config_hash_before='<absent>'
  config_mode_before='<absent>'
  if [ -e "$current_config" ]; then
    config_existed=1
    cp -p -- "$current_config" "$config_backup_file" || fail 5 'cannot back up user config'
    config_hash_before=$(sha256_file "$config_backup_file") || fail 5 'cannot hash config backup'
    config_mode_before=$(file_mode "$config_backup_file") || fail 5 'cannot read config mode'
  fi
  transaction_active=1
  trap 'transaction_exit' 0
  trap 'exit 5' 1 2 15
}

config_is_unchanged() {
  if [ "$config_existed" = 0 ]; then
    [ ! -e "$current_config" ] && [ ! -L "$current_config" ]
    return
  fi
  [ -f "$current_config" ] || return 1
  config_hash_after=$(sha256_file "$current_config") || return 1
  config_mode_after=$(file_mode "$current_config") || return 1
  [ "$config_hash_after" = "$config_hash_before" ] || return 1
  [ "$config_mode_after" = "$config_mode_before" ] || return 1
  cmp -s -- "$config_backup_file" "$current_config"
}

restore_config() {
  if [ "$config_existed" = 0 ]; then
    if [ -e "$current_config" ] || [ -L "$current_config" ]; then
      rm -rf -- "$current_config" || return 1
    fi
    return
  fi

  config_parent=$(dirname -- "$current_config")
  config_name=$(basename -- "$current_config")
  restore_path="$config_parent/.${config_name}.text-harness-restore.$$"
  altered_path="$config_parent/.${config_name}.text-harness-altered.$$"
  [ ! -e "$restore_path" ] && [ ! -e "$altered_path" ] || return 1
  cp -p -- "$config_backup_file" "$restore_path" || return 1
  if [ -d "$current_config" ] && [ ! -L "$current_config" ]; then
    mv -- "$current_config" "$altered_path" || return 1
    if ! mv -- "$restore_path" "$current_config"; then
      mv -- "$altered_path" "$current_config" 2>/dev/null
      return 1
    fi
    rm -rf -- "$altered_path" || return 1
    return
  fi
  mv -f -- "$restore_path" "$current_config"
}

cleanup_config_guard() {
  if [ -n "${config_backup_dir:-}" ] && [ -d "$config_backup_dir" ]; then
    rm -rf -- "$config_backup_dir"
  fi
}

transaction_exit() {
  original_exit=$?
  trap - 0 1 2 15
  [ "${transaction_active:-0}" = 1 ] || exit "$original_exit"

  config_changed=0
  config_is_unchanged || config_changed=1
  rollback_modules
  restore_failed=0
  if [ "$config_changed" = 1 ]; then
    restore_config || restore_failed=1
  fi
  if [ "$restore_failed" = 0 ]; then
    cleanup_config_guard
  fi
  transaction_active=0
  if [ "$config_changed" = 1 ] || [ "$restore_failed" = 1 ]; then
    if [ "$restore_failed" = 1 ]; then
      printf 'SETUP ERROR code=5 user config changed; restoration failed; backup=%s\n' "$config_backup_file" >&2
    else
      printf 'SETUP ERROR code=5 user config changed and was restored\n' >&2
    fi
    exit 5
  fi
  exit "$original_exit"
}

complete_transaction() {
  config_is_unchanged || fail 5 'user config changed during setup'
  discard_rollback
  cleanup_config_guard
  transaction_active=0
  trap - 0 1 2 15
}

install_and_verify() {
  rollback_dir=
  had_modules=0
  if [ -e node_modules ]; then
    [ -d node_modules ] || fail 5 'node_modules is not a directory'
    had_modules=1
    rollback_dir="$repository_root/.text-harness-node-modules.rollback.$$"
    [ ! -e "$rollback_dir" ] || fail 5 'rollback path already exists'
  fi
  prepare_config_guard
  if [ "$had_modules" = 1 ]; then
    mv -- node_modules "$rollback_dir" || fail 5 'cannot prepare dependency rollback'
  fi

  if ! pnpm install --frozen-lockfile; then
    fail 5 'dependency install failed; previous dependencies restored'
  fi
  if ! pnpm test:smoke; then
    fail 5 'smoke verification failed; previous dependencies restored'
  fi
  complete_transaction
}

main() {
  [ "$#" -gt 0 ] || usage
  parse_arguments "$@"
  find_repository_root
  check_toolchain
  check_repository
  current_config=$(config_path)
  hash_file "$current_config" >/dev/null
  if [ "$mode" = upgrade ]; then
    check_upgrade_baseline
  fi
  if [ "$mode" != check ]; then
    install_and_verify
  fi
  printf 'SETUP OK mode=%s\n' "$mode"
}

main "$@"
